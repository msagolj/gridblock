{
  "definitions": [
    {
      "title": "Grid",
      "id": "grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Grid",
              "model": "grid",
              "filter": "grid",
              "classes": "default"
            }
          }
        }
      }
    },
    {
      "title": "Grid Content Item",
      "id": "grid-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Grid Content Item",
              "model": "grid-item"
            }
          }
        }
      }
    },
    {
      "title": "Grid Image and Text",
      "id": "grid-image-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Grid Image and Text",
              "model": "grid-image-item",
              "classes": "grid-image-text",
              "classes_layout": "image-top",
              "text_headingType": "h3"
            }
          }
        }
      }
    },
    {
      "title": "Grid Fact",
      "id": "grid-fact",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Grid Fact",
              "model": "grid-fact",
              "classes": "grid-fact",
              "classes_layout": "text-only",
              "fact_valueType": "strong"
            }
          }
        }
      }
    },
    {
      "title": "Grid Link List",
      "id": "grid-link-list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Grid Link List",
              "model": "grid-link-list",
              "classes": "grid-link-list",
              "content_headingType": "h3"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "grid",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Layout preset",
          "valueType": "string",
          "value": "default",
          "options": [
            {
              "name": "Default",
              "value": "default"
            },
            {
              "name": "Spotlight",
              "value": "spotlight"
            },
            {
              "name": "Tiles",
              "value": "tiles"
            },
            {
              "name": "Spotlight 2",
              "value": "spotlight-2"
            },
            {
              "name": "Facts right",
              "value": "facts-right"
            },
            {
              "name": "Spotlight large",
              "value": "spotlight-large"
            }
          ]
        }
      ]
    },
    {
      "id": "grid-item",
      "fields": [
        {
          "component": "richtext",
          "name": "text",
          "label": "Main content",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "supporting",
          "label": "Supporting content",
          "description": "Optional second content region, such as a list of links.",
          "valueType": "string",
          "value": ""
        }
      ]
    },
    {
      "id": "grid-image-item",
      "fields": [
        {
          "component": "text",
          "name": "classes",
          "label": "Item type",
          "valueType": "string",
          "hidden": true
        },
        {
          "component": "select",
          "name": "classes_layout",
          "label": "Image position",
          "valueType": "string",
          "value": "image-top",
          "options": [
            {
              "name": "Above text",
              "value": "image-top"
            },
            {
              "name": "Below text",
              "value": "image-bottom"
            }
          ]
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Image",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Alternative text",
          "valueType": "string",
          "value": ""
        },
        {
          "component": "text",
          "name": "text_label",
          "label": "Label",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "text_heading",
          "label": "Heading",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "text_headingType",
          "label": "Heading level",
          "valueType": "string",
          "value": "h3",
          "options": [
            { "name": "Heading 2", "value": "h2" },
            { "name": "Heading 3", "value": "h3" },
            { "name": "Heading 4", "value": "h4" },
            { "name": "Heading 5", "value": "h5" },
            { "name": "Heading 6", "value": "h6" }
          ]
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Body text",
          "valueType": "string",
          "value": ""
        }
      ]
    },
    {
      "id": "grid-fact",
      "fields": [
        {
          "component": "text",
          "name": "classes",
          "label": "Item type",
          "valueType": "string",
          "hidden": true
        },
        {
          "component": "select",
          "name": "classes_layout",
          "label": "Presentation",
          "valueType": "string",
          "value": "text-only",
          "options": [
            { "name": "Fact only", "value": "text-only" },
            { "name": "Image above", "value": "image-top" },
            { "name": "Image below", "value": "image-bottom" }
          ]
        },
        {
          "component": "reference",
          "name": "factImage",
          "label": "Image",
          "valueType": "string",
          "multi": false,
          "condition": {
            "in": [
              { "var": "classes_layout" },
              ["image-top", "image-bottom"]
            ]
          }
        },
        {
          "component": "text",
          "name": "factImageAlt",
          "label": "Alternative text",
          "valueType": "string",
          "condition": {
            "in": [
              { "var": "classes_layout" },
              ["image-top", "image-bottom"]
            ]
          }
        },
        {
          "component": "text",
          "name": "fact_label",
          "label": "Label",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "fact_value",
          "label": "Value",
          "description": "Display text, such as ~50, 90+, $13.8b, or 32.4%.",
          "valueType": "string",
          "required": true
        },
        {
          "component": "text",
          "name": "fact_valueType",
          "label": "Value formatting",
          "valueType": "string",
          "value": "strong",
          "hidden": true
        },
        {
          "component": "richtext",
          "name": "fact_description",
          "label": "Description",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "grid-link-list",
      "fields": [
        {
          "component": "text",
          "name": "classes",
          "label": "Item type",
          "valueType": "string",
          "hidden": true
        },
        {
          "component": "text",
          "name": "content_label",
          "label": "Label",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "content_heading",
          "label": "Heading",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "content_headingType",
          "label": "Heading level",
          "valueType": "string",
          "value": "h3",
          "options": [
            { "name": "Heading 2", "value": "h2" },
            { "name": "Heading 3", "value": "h3" },
            { "name": "Heading 4", "value": "h4" },
            { "name": "Heading 5", "value": "h5" },
            { "name": "Heading 6", "value": "h6" }
          ]
        },
        {
          "component": "richtext",
          "name": "content_description",
          "label": "Introduction",
          "valueType": "string"
        },
        {
          "component": "container",
          "name": "links",
          "label": "Links",
          "multi": true,
          "fields": [
            {
              "component": "aem-content",
              "name": "link",
              "label": "URL",
              "valueType": "string",
              "required": true
            },
            {
              "component": "text",
              "name": "linkText",
              "label": "Link text",
              "valueType": "string",
              "required": true
            }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "grid",
      "components": [
        "grid-item",
        "grid-image-item",
        "grid-fact",
        "grid-link-list"
      ]
    }
  ]
}
